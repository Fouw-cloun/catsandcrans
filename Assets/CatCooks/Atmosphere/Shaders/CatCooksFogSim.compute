// =============================================================
//  CatCooksFogSim.compute
//  Симуляция поля плотности тумана и пыли на 2D-сетке.
//
//  Полноценная симуляция жидкости (Навье — Стокс) здесь не нужна и не нужна
//  принципиально: она требует поля давления, итераций проекции и нескольких
//  текстур. Вместо этого поле скоростей считается АНАЛИТИЧЕСКИ прямо в точке:
//
//      скорость = ветер
//               + расталкивание от каждого движущегося объекта
//               + закручивание вокруг него
//
//  Такое поле не сохраняет массу и вихри в нём живут недолго — но для тумана
//  под ногами и пыли на стройке этого достаточно, а стоит оно одного прохода
//  по текстуре вместо десятка.
//
//  Перенос делается ПОЛУЛАГРАНЖЕВОЙ АДВЕКЦИЕЙ: вместо того чтобы толкать
//  плотность вперёд (что рвёт поле на дыры), для каждого текселя смотрим,
//  ОТКУДА он приехал, и читаем плотность там. Билинейный фильтр GPU сглаживает
//  чтение сам, бесплатно.
//
//  Восстановление идёт к движущемуся шуму, а не к константе: иначе след от
//  колеса зарастал бы ровным серым пятном, которое видно даже сильнее следа.
// =============================================================

#pragma kernel CSMain

Texture2D<float> _Source;
RWTexture2D<float> _Result;

// Имя сэмплера Unity разбирает по подстрокам: linear + clamp.
SamplerState linearClampSampler;

uint  _Resolution;
float2 _Wind;          // в UV в секунду
float  _Regrow;        // скорость зарастания следов
float  _NoiseScale;    // крупность целевого шума
float  _NoiseDetail;   // доля второй октавы
float  _Patchiness;    // насколько рваное поле
float  _Gust;          // 0..1, порыв
float  _Time;
float  _Dt;

struct Disturber
{
    float2 position;   // UV
    float2 velocity;   // UV в секунду
    float  radius;     // UV
    float  push;       // расталкивание
    float  swirl;      // закручивание
    float  carve;      // 0 — не выедает, 1 — выедает дыру полностью
};

StructuredBuffer<Disturber> _Disturbers;
uint _DisturberCount;

float Hash(float2 p)
{
    p = frac(p * float2(127.1, 311.7));
    p += dot(p, p + 43.21);
    return frac(p.x * p.y * 95.4307);
}

float Noise(float2 p)
{
    float2 i = floor(p), f = frac(p);
    f = f * f * (3.0 - 2.0 * f);
    return lerp(lerp(Hash(i),                Hash(i + float2(1, 0)), f.x),
                lerp(Hash(i + float2(0, 1)), Hash(i + float2(1, 1)), f.x), f.y);
}

[numthreads(8, 8, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Resolution || id.y >= _Resolution) return;

    float2 uv = (id.xy + 0.5) / _Resolution;

    // ── ПОЛЕ СКОРОСТЕЙ ──
    // Ветер плюс вклад каждого объекта. Порыв разгоняет только ветер:
    // расталкивание от техники к погоде отношения не имеет.
    float2 velocity = _Wind * (1.0 + _Gust * 1.8);

    // Выедание и добавление считаем отдельно от адвекции, чтобы применить их
    // ПОСЛЕ переноса: иначе дыра размажется тем же переносом и потеряет форму.
    float carve = 1.0;
    float add = 0.0;

    for (uint i = 0; i < _DisturberCount; i++)
    {
        Disturber d = _Disturbers[i];

        float2 toTexel = uv - d.position;
        float dist = length(toTexel);
        float2 dir = toTexel / max(dist, 1e-5);

        // Гауссово влияние вместо smoothstep: у него нет края, а любой край
        // здесь виден как ровное кольцо вокруг объекта.
        float r = max(d.radius, 1e-4);
        float influence = exp(-dist * dist / (r * r * 6.0));

        float speed = length(d.velocity);

        // Расталкивание по радиусу: объект гонит туман перед собой.
        velocity += dir * (speed * d.push * influence);

        // Закручивание по касательной. Это и есть след: без него за машиной
        // остаётся просто коридор, а с ним — расходящиеся вихри.
        // Синус по расстоянию делает их чередующимися.
        velocity += float2(-dir.y, dir.x)
                  * (speed * d.swirl * influence * sin(_Time * 3.0 - dist * 45.0));

        if (d.carve >= 0.0)
        {
            // Тело объекта выедает дыру.
            float hole = smoothstep(r * 0.55, r, dist);
            carve *= lerp(1.0, hole, d.carve);
        }
        else
        {
            // Отрицательное значение означает ИСТОЧНИК: объект не расчищает
            // воздух, а мутит его. Так делается работающая техника — пыль от
            // отвала или болгарки не требует отдельной системы частиц.
            add += influence * (-d.carve) * 2.0;
        }
    }

    // ── АДВЕКЦИЯ ──
    // Смотрим, откуда тексель приехал, и читаем плотность там.
    float density = _Source.SampleLevel(linearClampSampler, uv - velocity * _Dt, 0);

    density = density * carve + add;

    // ── ЗАРАСТАНИЕ ──
    // Цель — движущийся двухоктавный шум. Октавы едут НАВСТРЕЧУ друг другу:
    // так рисунок не повторяется и не выглядит ползущей текстурой.
    float2 drift = _Wind * _Time;

    float n = Noise(uv * _NoiseScale + drift * 4.0) * (1.0 - _NoiseDetail * 0.5)
            + Noise(uv * _NoiseScale * 2.6 - drift * 2.0) * (_NoiseDetail * 0.5);

    // Возведение в степень делает поле рваным: у обычного шума среднее около
    // половины и он выглядит ровной мутью. Степень раздвигает плотное и
    // пустое, и получаются клочья.
    float k = lerp(1.0, 3.2, _Patchiness);
    n = pow(saturate(n), k);

    // НОРМАЛИЗАЦИЯ ПО СЕРЕДИНЕ. Без неё степень опускает среднее поля тем
    // сильнее, чем больше клочковатость: крутишь узор — уезжает плотность.
    // Делим так, чтобы шум со значением 0.5 всегда давал единицу. Теперь
    // «сколько тумана» и «какой у него рисунок» — независимые ручки.
    n /= max(0.03, pow(0.5, k));

    _Result[id.xy] = lerp(density, n, saturate(_Regrow * _Dt));
}
